# Copia este fichero como .env y pon tu clave de Google AI Studio (https://aistudio.google.com/apikey).
# La usan el RAG (embeddings + generación), el grafo multiagente y la tool multimodal.
GEMINI_API_KEY=
DATABASE_URL=

# Define una clave única y difícil de adivinar para proteger la API.
API_KEY=

# Orígenes permitidos por CORS (separados por coma)
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# Segundos máximos por turno de /ask y /approve (si se pasa: 504)
ASK_TIMEOUT_SECONDS=300
# Máximo de peticiones por clave en 60 s (si se pasa: 429)
RATE_LIMIT_PER_MINUTE=10